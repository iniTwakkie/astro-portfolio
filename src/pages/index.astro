---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import site from '../data/site.json';

const featuredProjects = (await getCollection('projects'))
    .filter((project) => project.data.published !== false && project.data.featured)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const recentPosts = (await getCollection('blog'))
    .filter((post) => post.data.published !== false)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 4);
---

<Layout title={site.title} description={site.description}>
    <section class="mb-14">
        <h1 class="text-3xl font-bold tracking-tight text-black mb-4">
            Finance, data, and automation — for teams that want clarity.
        </h1>
        <p class="text-lg text-zinc-700 leading-relaxed mb-4">
            I help businesses modernise their finance operations — building the reporting systems, models, and automations that turn raw data into decisions.
        </p>
        <p class="text-base text-zinc-700 leading-relaxed mb-4">
            I'm currently FP&amp;A Lead at Cambridge Spark. On the side, I build tools that make finance easier to run, like <a href="/projects" class="text-black border-b border-zinc-400 hover:border-black transition-colors">CardCode and dplan</a>, and I advise companies on finance ops, analytics, and automation.
        </p>
        <p class="text-base text-zinc-700 leading-relaxed mb-8">
            Want to work together? <a href="mailto:{site.email}" class="text-black border-b border-zinc-400 hover:border-black transition-colors">Get in touch</a> or find me on <a href={site.linkedin} target="_blank" rel="noreferrer" class="text-black border-b border-zinc-400 hover:border-black transition-colors">LinkedIn</a> and <a href={site.github} target="_blank" rel="noreferrer" class="text-black border-b border-zinc-400 hover:border-black transition-colors">GitHub</a>. Projects, writing, and things I find interesting live below.
        </p>
        <a href={`mailto:${site.email}`} class="not-prose inline-flex items-center rounded-lg bg-black px-4 py-2.5 text-sm font-semibold text-white hover:bg-zinc-700 transition-colors">
            Get in touch <span class="ml-2" aria-hidden="true">→</span>
        </a>
    </section>

    {recentPosts.length > 0 && (
        <section aria-labelledby="latest-writing-heading" class="mb-14">
            <div class="mb-4 flex items-baseline justify-between gap-4">
                <h2 id="latest-writing-heading" class="text-xl font-bold tracking-tight text-black">Latest writing</h2>
                <a href="/blog" class="text-sm font-medium text-zinc-500 hover:text-black transition-colors">View all →</a>
            </div>
            <ul class="flex flex-col">
                {recentPosts.map((post) => <BlogCard post={post} />)}
            </ul>
        </section>
    )}

    <section aria-labelledby="featured-projects-heading">
        <div class="mb-4 flex items-baseline justify-between gap-4">
            <h2 id="featured-projects-heading" class="text-xl font-bold tracking-tight text-black">Featured projects</h2>
            <a href="/projects" class="text-sm font-medium text-zinc-500 hover:text-black transition-colors">View all →</a>
        </div>
        <div class="flex flex-col gap-2">
            {featuredProjects.map((project) => <ProjectCard project={project} />)}
        </div>
    </section>
</Layout>