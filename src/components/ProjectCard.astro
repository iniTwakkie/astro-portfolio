---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, shortDesc, tech, codeLink, webHost, status } = project.data;
---

<article class="group py-5 px-4 -mx-4 rounded-xl border border-transparent hover:border-zinc-200 hover:bg-white transition-colors">
    <div class="flex items-start justify-between gap-4 mb-2">
        <h3 class="text-lg font-bold text-zinc-900 group-hover:text-black transition-colors">
            {title}
        </h3>
        {status && (
            <span class="shrink-0 rounded-full bg-zinc-100 px-2.5 py-1 text-xs font-medium text-zinc-600">
                {status}
            </span>
        )}
    </div>
    
    <p class="text-zinc-600 leading-relaxed mb-3">
        {shortDesc}
    </p>

    <p class="mb-4 text-xs text-zinc-500 font-mono">{tech}</p>

    {(webHost || codeLink) && <div class="flex items-center gap-4 text-sm">
        {webHost && (
            <a href={webHost} target="_blank" rel="noreferrer" class="font-semibold text-zinc-800 hover:text-black transition-colors">
                Visit project <span aria-hidden="true">↗</span>
            </a>
        )}
        {codeLink && (
            <a href={codeLink} target="_blank" rel="noreferrer" class="text-zinc-500 hover:text-black transition-colors font-medium">
                View code <span aria-hidden="true">↗</span>
            </a>
        )}
    </div>}
</article>
